# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# LaTeX build products.  main.pdf is tracked deliberately: the draft is the
# object of review and a reader should not have to install a TeX distribution
# to see it.  Everything else here is regenerated by latexmk.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.lof
*.lot
*.loa
*.synctex.gz

# Campaign outputs.  Metrics are written by the run scripts and re-derived
# from them; only the manifest that pins a result to its inputs is tracked,
# once there is one.
metrics/
paper/metrics/
*.npy
*.memmap

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
